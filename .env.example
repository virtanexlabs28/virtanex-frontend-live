# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# These are read on the server only. Never prefix them with NEXT_PUBLIC_.

# SMTP account used to deliver contact and booking requests (Gmail shown).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
# Gmail needs an app password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_PASS=your-app-password

# Where inquiries are delivered, and the From header (Gmail always sends as SMTP_USER).
MAIL_TO=you@gmail.com
MAIL_FROM="Virtanex Labs <you@gmail.com>"
